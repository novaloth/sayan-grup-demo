# Bu dosyayı .env.local olarak kopyalayıp değerleri doldurun. .env.local git'e eklenmez.
# NEXT_PUBLIC_ ile başlayan değişkenler tarayıcıya açılır; gizli bilgi koymayın.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# E-bülten servisi (src/lib/newsletter.ts). Servis belirlenince doldurulacak.
# NEWSLETTER_API_URL=
# NEWSLETTER_API_KEY=

# İçerik backend'i / CMS (src/lib/content.ts). Bağlanınca doldurulacak.
# CMS_API_URL=
# CMS_API_TOKEN=
